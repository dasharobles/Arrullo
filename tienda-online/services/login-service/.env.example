NODE_ENV=production
PORT=10000
API_PREFIX=/api/v1
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=arrullo_login
DB_PASSWORD=
DB_NAME=ventas_db
DB_CONNECTION_LIMIT=10
DB_SSL=true
JWT_SECRET=replace-with-unique-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_ISSUER=microservicio-login
BCRYPT_SALT_ROUNDS=12
HTTPS_ENABLED=false
CORS_ORIGIN=https://your-arrullo-host
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
USUARIOS_DEMO_PASSWORD=replace-with-unused-random-value
ARRULLO_ADMIN_USERNAME=
ARRULLO_ADMIN_EMAIL=
ARRULLO_ADMIN_NAME=
ARRULLO_ADMIN_INITIAL_PASSWORD=

